config KLAUSSCPU_SSH_SERVER
	bool "KlaussCPU SSH server"
	default n
	depends on NET_SOCKETS
	depends on DISK_KLAUSSCPU_SD
	help
	  SSH server using wolfSSH over Zephyr sockets.
	  Requires wolfSSL and wolfSSH libraries to be available.
	  Provides an interactive shell with filesystem and hardware commands.

config KLAUSSCPU_HTTP_SERVER
	bool "KlaussCPU HTTP file server"
	default n
	depends on NET_SOCKETS
	depends on FILE_SYSTEM
	help
	  Minimal raw-socket HTTP/1.0 file server on port 80 serving the SD card
	  (/SD:): GET downloads files / lists directories, PUT uploads files.
	  No auth or TLS — intended for trusted LAN use.

config KLAUSSCPU_HTTPS_SERVER
	bool "KlaussCPU HTTPS file server"
	default n
	depends on NET_SOCKETS
	depends on FILE_SYSTEM
	depends on WOLFSSL
	help
	  HTTP-over-TLS file server on port 443 serving the SD card (/SD:),
	  reusing the HTTP request dispatch.  Presents a self-signed ECDSA
	  P-256 certificate, generated on first boot and persisted to the SD
	  card.  Supports TLS 1.2 and 1.3.  No client-certificate auth.

config KLAUSSCPU_HTTP_PUT
	bool "Accept uploads (PUT) on the HTTP and HTTPS file servers"
	depends on KLAUSSCPU_HTTP_SERVER || KLAUSSCPU_HTTPS_SERVER
	help
	  PUT /<path> writes the file with no login, so anyone who can reach
	  the board could replace any file on the card.  Off by default:
	  upload over SFTP instead.  The key folder (/SD:/sys) is refused
	  either way.

config KLAUSSCPU_SHELL_CMDS
	bool "KlaussCPU shell commands"
	default y if SHELL
	depends on SHELL
	depends on FILE_SYSTEM
	help
	  Register filesystem and hardware commands with the Zephyr shell.
	  Available on the UART console independently of the SSH server.

config KLAUSSCPU_PYTHON
	bool "python shell command (MicroPython)"
	depends on KLAUSSCPU_SSH_SERVER
	depends on KLAUSSCPU_SHELL_CMDS
	depends on FILE_SYSTEM
	select KLAUSSCPU_LIBC_EXTRAS
	help
	  MicroPython (modules/lib/micropython) as the `python` shell command:
	  a REPL on the session, or `python file.py [args]` from the SD card
	  (micropython/ssh, MICROPYTHON_PLAN.md).

config KLAUSSCPU_PYTHON_HEAP_SIZE
	int "MicroPython GC heap size (bytes)"
	depends on KLAUSSCPU_PYTHON
	default 1048576
	help
	  A static buffer, used by one session at a time.
