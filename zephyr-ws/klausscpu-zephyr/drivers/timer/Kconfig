config KLAUSSCPU_TIMER
	bool "KlaussCPU system timer"
	default n
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	help
	  System tick timer for the KlaussCPU MMIO interrupt controller.
	  Fixed-rate (10 kHz @ 100 MHz CPU); does NOT support tickless —
	  sys_clock_set_timeout() is a no-op and sys_clock_elapsed() returns 0.
	  Do NOT select TICKLESS_CAPABLE here, or k_msleep / timeouts won't fire.
	  k_cycle_get_32/64() read the free-running PERF_CYCLES counter
	  (0xF00D_0008, 48-bit @ 100 MHz — wraps after ~32 days); a perf-counter
	  clear (PERF_CTRL[0]) zeroes it, invalidating in-flight cycle deltas.
