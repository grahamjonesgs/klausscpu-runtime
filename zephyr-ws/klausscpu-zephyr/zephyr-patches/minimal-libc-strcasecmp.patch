+++ b/lib/libc/minimal/source/string/strcasecmp.c
@@ -0,0 +1,13 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <stdint.h>
+#include <strings.h>
+
+/* Case-insensitive compare of NUL-terminated strings (POSIX strcasecmp). */
+int
+strcasecmp(const char *s1, const char *s2)
+{
+	return strncasecmp(s1, s2, SIZE_MAX);
+}
