+/**
+ * @brief Architecture specific check of an extension's ELF header
+ *
+ * Called by llext_load() once the ELF magic and file type are known to be
+ * valid, before anything else is read or allocated.  An architecture whose
+ * extensions carry an ABI or ISA version (in e_machine or e_flags) refuses
+ * an incompatible one here instead of running code that would crash.  The
+ * default implementation accepts every header.
+ *
+ * @param[in] hdr The extension's ELF header
+ * @retval 0 The extension may be loaded
+ * @retval -ENOEXEC The extension was built for another machine or ABI
+ */
+int arch_elf_check_header(const elf_ehdr_t *hdr);
