diff --git a/include/zephyr/toolchain/gcc.h b/include/zephyr/toolchain/gcc.h
index 637a092e0..853c7b8f4 100644
--- a/include/zephyr/toolchain/gcc.h
+++ b/include/zephyr/toolchain/gcc.h
@@ -635,6 +635,18 @@ do {                                                                    \
 		"\n\t.equ\t" #name "," #value        \
 		"\n\t.type\t" #name ",#object")
 
+#elif defined(CONFIG_CPU_KLAUSSCPU)
+/* KlaussCPU: 64-bit LE ELF, uses @object ELF type notation. */
+#define GEN_ABSOLUTE_SYM(name, value)		\
+	__asm__(".globl\t" #name "\n\t.equ\t" #name \
+		",%c0"                              \
+		"\n\t.type\t" #name ",@object" :  : "n"(value))
+
+#define GEN_ABSOLUTE_SYM_KCONFIG(name, value)       \
+	__asm__(".globl\t" #name                    \
+		"\n\t.equ\t" #name "," #value       \
+		"\n\t.type\t" #name ",@object")
+
 #elif defined(CONFIG_HEXAGON)
 /* Hexagon (Qualcomm DSP) - use standard assembly approach */
 #define GEN_ABSOLUTE_SYM(name, value)                                                              \
