+
+/* Is `path` the file `p`, or inside the directory `p`?  FAT ignores case. */
+static int z_covers(const char* p, const char* path)
+{
+    while (*p != '\0' && z_lower(*p) == z_lower(*path)) {
+        p++;
+        path++;
+    }
+    return *p == '\0' && (*path == '\0' || *path == '/');
