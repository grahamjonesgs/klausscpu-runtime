+
+/* Reopen what z_park closed, now at `to` in place of `from`.  What can't be
+ * reopened stays retired.  Holds z_fds_lock. */
+static void z_unpark(int group, const char* from, const char* to)
+{
+    static char path[WOLFSSH_MAX_FILENAME];
+    WFD idx;
+
+    for (idx = 0; idx < WOLFSSH_MAX_DESCIPRTORS; idx++) {
+        if (z_fds[idx].parked == group) {
+            const char* rest = z_fds[idx].path + WSTRLEN(from);
+
+            z_fds[idx].parked = 0;
+            if (WSTRLEN(to) + WSTRLEN(rest) >= sizeof(path))
+                continue;
+            WSTRNCPY(path, to, sizeof(path));
+            WSTRNCPY(path + WSTRLEN(to), rest, sizeof(path) - WSTRLEN(to));
+            fs_file_t_init(&z_fds[idx].zfp);
+            if (fs_open(&z_fds[idx].zfp, path, z_fds[idx].flags) == 0) {
+                z_fds[idx].retired = 0;
+                WSTRNCPY(z_fds[idx].path, path, sizeof(z_fds[idx].path));
+            }
+        }
+    }
+}
