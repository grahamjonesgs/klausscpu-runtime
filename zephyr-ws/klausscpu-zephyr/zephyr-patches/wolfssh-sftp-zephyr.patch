+/* fs_rename on FAT removes `to` first.  So a rename from a name that doesn't
+ * exist would just delete `to`, and one that only changes the case of a name
+ * would delete the file: FAT sees the two names as one.  And FatFs lets a
+ * directory move into itself, which orphans the whole tree. */
+int wssh_z_rename(const char* from, const char* to)
+{
+    static char tmp[WOLFSSH_MAX_FILENAME];
+    struct fs_dirent ent;
+    int same;
+    int ret;
+
+    k_mutex_lock(&z_fds_lock, K_FOREVER);
+    ret = fs_stat(from, &ent);
+    if (ret != 0 || WSTRCMP(from, to) == 0)
+        goto out;
+
+    same = z_same(from, to);
+    if (!same && z_covers(from, to)) {
+        ret = -EINVAL;
+        goto out;
+    }
+    if (same) {
+        if (WSTRLEN(from) + 6 > sizeof(tmp)) {
+            ret = -ENAMETOOLONG;
+            goto out;
+        }
+        WSTRNCPY(tmp, from, sizeof(tmp));
+        WSTRNCPY(tmp + WSTRLEN(from), ".~ren", sizeof(tmp) - WSTRLEN(from));
+        if (fs_stat(tmp, &ent) == 0) {
+            ret = -EEXIST;
+            goto out;
         }
     }
+
+    z_park(from, 1, -1, Z_PARK_FROM);
+    if (same) {
+        ret = fs_rename(from, tmp);
+        if (ret == 0) {
+            ret = fs_rename(tmp, to);
+            if (ret != 0)
+                (void)fs_rename(tmp, from);
+        }
+    }
+    else {
+        z_park(to, 1, -1, Z_PARK_TO);
+        ret = fs_rename(from, to);
+    }
+    if (ret == 0) {
+        z_unpark(Z_PARK_FROM, from, to);
+        z_drop(Z_PARK_TO);
+    }
+    else {
+        z_unpark(Z_PARK_FROM, from, from);
+        z_unpark(Z_PARK_TO, to, to);
+    }
+out:
+    k_mutex_unlock(&z_fds_lock);
     return ret;
 }
 
