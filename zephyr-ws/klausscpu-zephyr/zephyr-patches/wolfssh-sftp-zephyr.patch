+
+/* Close the writers of p and of anything under it, and with `readers` the
+ * readers too, other than keep.  Holds z_fds_lock. */
+static void z_park(const char* p, int readers, WFD keep, int group)
+{
+    WFD idx;
+
+    for (idx = 0; idx < WOLFSSH_MAX_DESCIPRTORS; idx++) {
+        if (idx != keep && z_fds[idx].open && !z_fds[idx].retired &&
+                (z_fds[idx].write || readers) &&
+                z_covers(p, z_fds[idx].path)) {
+            if (fs_close(&z_fds[idx].zfp) != 0)
+                z_fds[idx].closeFailed = 1;
+            z_fds[idx].retired = 1;
+            z_fds[idx].parked = group;
+        }
+    }
