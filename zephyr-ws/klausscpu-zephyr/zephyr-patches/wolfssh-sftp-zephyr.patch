+/* The size of an open file, leaving its position alone. */
+static int z_size(WFILE* f, off_t* size)
+{
+    off_t pos = fs_tell(f);
+    off_t end;
+
+    if (pos < 0 || fs_seek(f, 0, FS_SEEK_END) != 0)
+        return -1;
+    end = fs_tell(f);
+    if (fs_seek(f, pos, FS_SEEK_SET) != 0 || end < 0)
+        return -1;
+    *size = end;
+    return 0;
+}
+
+/* Truncate or extend, and check that it happened: extending stops silently
+ * when the card is full. */
+static int z_truncate(WFILE* f, off_t size)
+{
+    off_t cur, now;
+
+    if (size < 0 || z_size(f, &cur) != 0)
+        return -1;
+    if (size > cur && size - cur > WSSH_Z_MAX_GROW)
+        return -1;
+    if (fs_truncate(f, size) != 0 || z_size(f, &now) != 0 || now != size)
+        return -1;
+    return 0;
+}
