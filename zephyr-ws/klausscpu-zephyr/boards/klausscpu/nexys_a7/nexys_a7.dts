/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "KlaussCPU on Digilent Nexys A7";
	compatible = "klausscpu,nexys-a7";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,entropy = &trng0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			compatible = "klausscpu,klausscpu";
			device_type = "cpu";
			reg = <0>;
		};
	};

	/*
	 * 128 MiB RAM.  First 32 bytes (0x00-0x1F) are the hardware heap
	 * header; code starts at 0x20.  Top 64 KiB reserved for stack.
	 * Zephyr places its BSS/data here; kernel + app live in .text.
	 */
	sram0: memory@20 {
		compatible = "mmio-sram";
		reg = <0x00000020 0x07FF0000>;
	};

	/* KlaussCPU UART — single MMIO byte at 0xF0010000 (TX/RX register). */
	uart0: uart@f0010000 {
		compatible = "klausscpu,uart";
		reg = <0xF0010000 0x10>;
		status = "okay";
		current-speed = <115200>;
	};

	/* Interrupt controller + timer at 0xF00F_0000. */
	timer0: timer@f00f0000 {
		compatible = "klausscpu,timer";
		reg = <0xF00F0000 0x50>;
		status = "okay";
	};

	/* LiteEth MAC — CSRs at 0xF006_0000, slot SRAM at 0xF008_0000. */
	eth0: ethernet@f0060000 {
		compatible = "klausscpu,ethernet";
		reg = <0xF0060000 0x2000>;
		status = "okay";
	};

	/* True random number generator at 0xF00C_0000. */
	trng0: trng@f00c0000 {
		compatible = "klausscpu,trng";
		reg = <0xF00C0000 0x100>;
		status = "okay";
	};

	/*
	 * QSPI configuration flash (S25FL128S, 16 MiB) through qspi_ctrl at
	 * 0xF012_0000.  The FPGA bitstream is below 0xF0_0000; the hardware
	 * refuses program/erase there.  Offsets are flash byte addresses.
	 */
	qspi0: flash-controller@f0120000 {
		compatible = "klausscpu,qspi-flash";
		reg = <0xF0120000 0x200>;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		flash0: flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 0x1000000>;
			erase-block-size = <0x10000>;
			write-block-size = <1>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				bitstream_partition: partition@0 {
					label = "bitstream";
					reg = <0x0 0xF00000>;
					read-only;
				};
				/* Private keys (ssh/keystore.c, NVS). */
				storage_partition: partition@f00000 {
					label = "storage";
					reg = <0xF00000 0xC0000>;
				};
				/* Board tests (klaussCPU tools/board/qspi_test.c). */
				scratch_partition: partition@fc0000 {
					label = "scratch";
					reg = <0xFC0000 0x40000>;
				};
			};
		};
	};

	/* SD card SPI controller at 0xF000_0000. */
	sd0: sd@f0000000 {
		compatible = "klausscpu,sd";
		reg = <0xF0000000 0x1000>;
		status = "okay";
	};
};
