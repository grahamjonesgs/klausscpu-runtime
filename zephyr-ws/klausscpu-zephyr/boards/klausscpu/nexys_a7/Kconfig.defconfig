if BOARD_NEXYS_A7

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 100000000   # 100 MHz

# Enable the KlaussCPU UART as the console.
config UART_KLAUSSCPU
	default y

config UART_CONSOLE
	default y

# Enable the KlaussCPU timer.
config KLAUSSCPU_TIMER
	default y

config HEAP_MEM_POOL_SIZE
	default 65536

# The TRNG entropy driver (chosen zephyr,entropy) backs sys_rand_get/
# sys_csrand_get and mbedTLS, so every app gets it.
config ENTROPY_GENERATOR
	default y

# FatFs takes its volume names from devicetree only for Zephyr's own disk
# compatibles, so the SD card (klausscpu,sd, registered as "SD") is named here.
config FS_FATFS_CUSTOM_MOUNT_POINTS
	default "SD" if FAT_FILESYSTEM_ELM

config FS_FATFS_CUSTOM_MOUNT_POINT_COUNT
	default 1 if FAT_FILESYSTEM_ELM

endif # BOARD_NEXYS_A7
