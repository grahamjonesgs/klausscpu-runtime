config ARCH
	default "klausscpu"

config ARCH_IS_SET
	bool
	default y

# KlaussCPU is 64-bit little-endian, 32-bit physical address space.
config 64BIT
	default y

config CPU_KLAUSSCPU
	bool
	select ATOMIC_OPERATIONS_C
	select USE_SWITCH_SUPPORTED
	select USE_SWITCH
	# Toolchain emits ELFCLASS32 relocatable objects even though the C ABI
	# uses 64-bit pointers (CONFIG_64BIT=y), so llext must parse 32-bit ELF.
	select LLEXT_ELF_CLASS32 if LLEXT
	# Build in C11.  Clang reports __GNUC__ 4.2, so under -std=c99
	# toolchain/gcc.h defines BUILD_ASSERT() as nothing and every
	# kernel, arch and driver build-time check is silently skipped.
	select REQUIRES_STD_C11

config ARCH_HAS_USERSPACE
	bool
	default n

config ARCH_HAS_STACK_PROTECTION
	bool
	default n

config ARCH_HAS_TRUSTED_EXECUTION
	bool
	default n

config SMP
	default n

config MP_MAX_NUM_CPUS
	default 1

config STACK_ALIGN_SIZE
	int
	default 8

config ARCH_STACK_GROWS_DOWN
	bool
	default y

config KERNEL_VM_SUPPORT
	default n

config MMU
	default n

# Interrupt handlers run on z_interrupt_stacks (arch/klausscpu/core/swap.S).
# The port's earlier private ISR stack was 4 KiB, so keep that headroom: a tick
# runs every expiring k_timer callback, and a device handler may printk.
config ISR_STACK_SIZE
	default 4096

# The hardware does not set DI on interrupt entry, so a second source can be
# taken before a stub's DI retires and its frame (8 bytes) plus register save
# (128 bytes) lands on the interrupted thread's own stack, a second time.  Every
# thread stack must hold two such frames (about 280 bytes) beyond its own use.
# The idle thread's default (256) does not.
config IDLE_STACK_SIZE
	default 1024
