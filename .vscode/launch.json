{
  // KlaussCPU source-level debugging with lldb-dap (see DEBUGGING.md).
  // Needs the "LLDB DAP" extension (llvm-vs-code-extensions.lldb-dap) and
  // the lldb-dap built in klausscpu-llvm (stock lldb does not know KlaussCPU).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KlaussCPU: debug the open bare-metal program on the emulator",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      "preLaunchTask": "klausscpu: emulator gdbserver",
      // FreeRTOS tasks / Zephyr threads as debugger threads (debug/klausscpu_rtos.py).
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      "attachCommands": [
        "target create ${workspaceFolder}/baremetal/${fileBasenameNoExtension}.elf",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: debug the open bare-metal program on the board (JTAG)",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      // Loads over the UART, halts at the entry, serves core 1 over JTAG.
      // Needs a DEBUG_EN=1 bitstream (klaussCPU DEBUG_PLAN.md) and klausscc
      // built with --features board.
      "preLaunchTask": "klausscpu: board gdbserver",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      "attachCommands": [
        "target create ${workspaceFolder}/baremetal/${fileBasenameNoExtension}.elf",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: FreeRTOS program on the emulator",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      // Asks for the program (freertos/<name>.elf), builds it with -g, serves it on the emulator.
      "preLaunchTask": "klausscpu: FreeRTOS emulator gdbserver",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      // the task links the ELF it built to debug/.rtos.elf; open the real file
      "attachCommands": [
        "script import os; lldb.debugger.HandleCommand('target create ' + os.path.realpath('${workspaceFolder}/debug/.rtos.elf'))",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: FreeRTOS program on the board (JTAG)",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      // As above, loaded onto the board over the UART halted at its entry; core 1 over JTAG.
      "preLaunchTask": "klausscpu: FreeRTOS board gdbserver",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      // the task links the ELF it built to debug/.rtos.elf; open the real file
      "attachCommands": [
        "script import os; lldb.debugger.HandleCommand('target create ' + os.path.realpath('${workspaceFolder}/debug/.rtos.elf'))",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: Zephyr app on the emulator",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      // Asks for the app (klausscpu-zephyr/apps/<app> or zephyr/samples/<app>), west-builds it with debug info.
      "preLaunchTask": "klausscpu: Zephyr emulator gdbserver",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      // the task links the ELF it built to debug/.rtos.elf; open the real file
      "attachCommands": [
        "script import os; lldb.debugger.HandleCommand('target create ' + os.path.realpath('${workspaceFolder}/debug/.rtos.elf'))",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: Zephyr app on the board (JTAG)",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      // As above, loaded onto the board over the UART halted at its entry; core 1 over JTAG.
      "preLaunchTask": "klausscpu: Zephyr board gdbserver",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      // the task links the ELF it built to debug/.rtos.elf; open the real file
      "attachCommands": [
        "script import os; lldb.debugger.HandleCommand('target create ' + os.path.realpath('${workspaceFolder}/debug/.rtos.elf'))",
        "gdb-remote 1234"
      ],
      "stopOnEntry": false
    },
    {
      "name": "KlaussCPU: attach to a running gdbserver (port 1234)",
      "type": "lldb-dap",
      "request": "attach",
      "debugAdapterExecutable": "${workspaceFolder}/../klausscpu-llvm/build/bin/lldb-dap",
      "initCommands": [
        "settings set target.process.python-os-plugin-path ${workspaceFolder}/debug/klausscpu_rtos.py"
      ],
      "attachCommands": [
        "target create ${input:elf}",
        "gdb-remote 1234"
      ]
    }
  ],
  "inputs": [
    {
      "id": "elf",
      "type": "promptString",
      "description": "ELF being served (with debug info)",
      "default": "${workspaceFolder}/baremetal/dbgtest.elf"
    }
  ]
}
