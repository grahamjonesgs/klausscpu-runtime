# Build artifacts
*.o
*.lo
crt-*.o
*.elf
*.bin
*.s
# LLEXT loadable extensions built by `make ext-demos`
*.llext
# Hand-written assembly *.S — note macOS APFS/HFS+ is case-insensitive, so
# `*.s` above would otherwise drop `.S` files too. Negate the rule here.
!*.S

# Compiler-generated header dependency files (-MMD -MP)
*.d

# FPGA loader output
*.code
*.kbt

# picolibc — generated by build-picolibc.sh
picolibc-src/
picolibc-build/
picolibc-install/
picolibc-cross-abs.ini

# lwIP — cloned externally, not part of this repo
lwip/

# doomgeneric — cloned by apps/doom/fetch-doomgeneric.sh, not part of this repo
zephyr-ws/klausscpu-zephyr/apps/doom/doomgeneric-src/

# Local Claude Code agent state (settings, scheduled-task lock) — not part of the build
.claude/
