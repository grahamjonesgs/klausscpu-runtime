# lldb session for run_debug_smoke.sh (@ELF@ / @PORT@ are substituted).
settings set auto-confirm true
target create @ELF@
gdb-remote @PORT@
# Return values the ABI plugin reads: a 16-byte struct (r12/r11), an
# unsigned int.
breakpoint set -n midpoint
breakpoint set -n neg_u32
continue
thread step-out
continue
thread step-out
breakpoint delete
breakpoint set -n dist2
breakpoint set -n square
continue
bt
frame variable *a *b
continue
thread step-out
breakpoint delete
breakpoint set -n fib -c 'n == 1'
continue
bt
# The ABI plugin's fallback unwind plans (llvm/TargetParser/KlaussCPUABI.h).
target modules show-unwind -n fib
breakpoint delete
watchpoint set variable counter
continue
continue
continue
frame variable i counter
watchpoint delete
register read pc sp r12 flags
# Frames without a frame record, unwound from the CFI: square() reached by
# hop()'s tail call (lldb shows hop as an artificial frame, from the
# DW_AT_call_tail_call site), checked()'s frameless early exit, and square() under
# checked()'s shrink-wrapped frame.
breakpoint set -n square -c 'v == 5'
breakpoint set -n checked -c 'p == 0'
breakpoint set -n square -c 'v == 7'
continue
bt
thread step-out
continue
bt
thread step-out
continue
bt
thread step-out
thread step-out
breakpoint delete
# The __builtin_debugtrap() stops with SIGTRAP; in batch mode a signal stop
# ends the script, so let lldb report it and resume (skipping the TRAP).
process handle SIGTRAP --stop false --notify true --pass false
continue
