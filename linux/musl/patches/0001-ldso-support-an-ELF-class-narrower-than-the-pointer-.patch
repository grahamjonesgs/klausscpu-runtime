+#if DL_ELFCLASS == 32 && UINTPTR_MAX != 0xffffffff
+typedef Elf32_Word Word;
+typedef Elf32_Sword Sword;
+#define DL_ELF_NARROW 1
+#else
+typedef size_t Word;
+typedef ptrdiff_t Sword;
+#define DL_ELF_NARROW 0
+#endif
