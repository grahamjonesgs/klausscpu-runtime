+/* The ELF class is that of the pointer size unless the arch's reloc.h
+ * defines DL_ELFCLASS: 32 with 64-bit pointers means ELFCLASS32 files
+ * for an LP64 C ABI. The dynamic section and the relocation tables are
+ * then arrays of 32-bit Word, not of size_t, the r_addend is
+ * sign-extended, and the fields relocations write are still size_t. */
+#ifndef DL_ELFCLASS
+#if UINTPTR_MAX == 0xffffffff
+#define DL_ELFCLASS 32
+#else
+#define DL_ELFCLASS 64
+#endif
+#endif
