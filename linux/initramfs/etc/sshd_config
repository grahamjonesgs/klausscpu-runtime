# OpenSSH sshd for KlaussCPU Linux (linux/initramfs/etc/sshd_config,
# installed as /etc/ssh/sshd_config).  Host keys come from
# /etc/init.d/sshkeys (-h options on the command line), in /run/ssh.
Port 22
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
# /etc/ssh/authorized_keys.d/<user>: keys from the image (root's, from
# build-rootfs.sh, which then turns PasswordAuthentication off and
# PermitRootLogin to prohibit-password); ~/.ssh/authorized_keys: each
# user's own, on /data.
AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys.d/%u
PidFile /run/sshd.pid
PrintMotd no
# No reverse DNS lookup of every client: slow, and often no DNS here.
UseDNS no
Subsystem sftp /usr/libexec/sftp-server
