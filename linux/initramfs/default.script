#!/bin/sh
# udhcpc's default script: apply the lease to the interface.  DNS servers
# go to /run/resolv.conf (/etc/resolv.conf links there; / may be read-only).
case "$1" in
deconfig)
	ifconfig "$interface" 0.0.0.0
	;;
bound|renew)
	ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" up
	if [ -n "$router" ]; then
		while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
		for r in $router; do
			route add default gw "$r" dev "$interface"
			break
		done
	fi
	: >/run/resolv.conf
	[ -n "$domain" ] && echo "search $domain" >>/run/resolv.conf
	for d in $dns; do
		echo "nameserver $d" >>/run/resolv.conf
	done
	;;
esac
exit 0
