#!/bin/sh
# /etc/init.d/rcS: busybox init's sysinit for the KlaussCPU Linux port.
#
# On the SD card's system image the root is read-only: what changes at run
# time goes to tmpfs (/tmp, /run; /var's entries and /etc/resolv.conf and
# /etc/dropbear link there) or to /data (data.img: /root and /home link
# into it).  Local settings live in /data/etc:
#   network   shell variable assignments: HOSTNAME, NTP_SERVER (default
#             pool.ntp.org; "none" turns ntpd off), and IP (a static address
#             instead of DHCP) with NETMASK, GATEWAY and DNS.  Read in a
#             subshell, which hands back only those variables: a broken
#             file gets a warning and the defaults, not a dead boot.
#   rc.local  run at the end of this script, in its own shell in the
#             background, so it can't stop or hang the boot
#   TZ        the time zone as a POSIX TZ string, e.g. SAST-2 (UTC if absent;
#             read by /etc/profile)
# There is no real-time clock: the clock starts at 1970 and ntpd sets it from
# the network once eth0 is up.
#
# The standalone shell runs applets through /proc/self/exe, so /proc goes
# first, through the binary itself.
/bin/busybox mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=755 tmpfs /run
mkdir -p /run/log /run/lock /run/dropbear
# mdev: hotplug for devices that appear later, and a pass over /sys now.
echo /sbin/mdev > /proc/sys/kernel/hotplug
mdev -s

if [ -L /root ] && grep -q '^tmpfs /data ' /proc/mounts; then
	echo "rcS: WARNING: /data is in RAM (no usable /linux/data.img on the SD card):"
	echo "rcS: WARNING: /root, /home and /data/etc are lost at reboot"
fi

# Users (the SD system image): /etc/passwd, group, shadow and gshadow link
# to /data/etc, so adduser, deluser, addgroup and passwd work and last.
# Seed them from the image's /etc/users.default, and keep the image's
# system accounts in them (a newer image may add one).
if [ -L /etc/passwd ] && [ -d /etc/users.default ]; then
	mkdir -p /data/etc /data/home
	for f in passwd group shadow gshadow; do
		d=/data/etc/$f
		if [ ! -e $d ]; then
			cp /etc/users.default/$f $d && echo "rcS: users: /data/etc/$f from the image's defaults"
		fi
		while IFS= read -r line; do
			grep -q "^${line%%:*}:" $d || echo "$line" >>$d
		done </etc/users.default/$f
	done
	chmod 644 /data/etc/passwd /data/etc/group
	chmod 600 /data/etc/shadow /data/etc/gshadow
	# sudo's local rules (/etc/sudoers includes the directory).
	mkdir -p /data/etc/sudoers.d && chmod 750 /data/etc/sudoers.d
fi

HOSTNAME=klausscpu
IP=
NETMASK=255.255.255.0
GATEWAY=
DNS=
NTP_SERVER=pool.ntp.org
# The known variables of /data/etc/network, as single-quoted assignments.
netvars() {
	. /data/etc/network >/dev/null 2>&1 </dev/null || exit 1
	for v in HOSTNAME IP NETMASK GATEWAY DNS NTP_SERVER; do
		eval "val=\${$v}"
		printf "%s='%s'\n" "$v" "$(printf %s "$val" | sed "s/'/'\\\\''/g")"
	done
}
if [ -r /data/etc/network ]; then
	if vars=$(netvars) && [ -n "$vars" ]; then
		eval "$vars"
		echo "rcS: settings from /data/etc/network"
	else
		echo "rcS: WARNING: /data/etc/network failed to load; using the defaults"
	fi
fi
hostname "$HOSTNAME" || hostname klausscpu

ifconfig lo 127.0.0.1 up
if [ -e /sys/class/net/eth0 ]; then
	ifconfig eth0 up
	# The PHY needs a few seconds to link; DHCP before that just times out.
	i=0
	while [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" != 1 ] && [ $i -lt 20 ]; do
		sleep 0.5; i=$((i + 1))
	done
	if [ -n "$IP" ] && ifconfig eth0 "$IP" netmask "$NETMASK" up; then
		echo "rcS: static address $IP (/data/etc/network)"
		[ -n "$GATEWAY" ] && route add default gw "$GATEWAY"
		: >/run/resolv.conf
		for d in $DNS; do
			echo "nameserver $d" >>/run/resolv.conf
		done
	else
		[ -n "$IP" ] && echo "rcS: WARNING: static address $IP failed; trying DHCP"
		# DHCP (the router reserves 192.168.68.59 for 00:ab:cd:00:00:01),
		# else that address statically: judged by the address eth0 ends up
		# with, not udhcpc's status.  udhcpc's output is in /tmp/udhcpc.log.
		udhcpc -i eth0 -n -q -t 5 -T 2 >/tmp/udhcpc.log 2>&1
		if ! ifconfig eth0 | grep -q 'inet addr'; then
			echo "rcS: no DHCP lease (see /tmp/udhcpc.log), using 192.168.68.59"
			ifconfig eth0 192.168.68.59 netmask 255.255.255.0 up
			route add default gw 192.168.68.1
		fi
	fi
	ifconfig eth0 | grep 'inet addr'
	# No RTC: ntpd steps the clock at its first answer and keeps it right.
	# It runs in the background, so a boot without a network isn't held up.
	if [ -n "$NTP_SERVER" ] && [ "$NTP_SERVER" != none ]; then
		ntpd -p "$NTP_SERVER" && echo "rcS: ntpd ($NTP_SERVER)"
	fi
	# SSH: OpenSSH's sshd on port 22 when the system has it (the SD root),
	# with Dropbear beside it on 2222 as a fallback; the initramfs alone
	# has only Dropbear, on 22.  sshd must be started by its full path.
	# A system image with root's keys (/etc/ssh/authorized_keys.d/root, from
	# build-rootfs.sh) takes key logins only: sshd's config says so, Dropbear
	# gets -s and reads the keys from /root/.ssh (on /data).  The initramfs
	# alone keeps password logins, for recovery.
	# Dropbear reads only ~/.ssh/authorized_keys: the image's root keys
	# are added to /root/.ssh/authorized_keys (keys added there by hand
	# stay).  Other users keep their keys in ~/.ssh/authorized_keys.
	DB_OPT=
	AKR=/etc/ssh/authorized_keys.d/root
	if [ -s $AKR ]; then
		DB_OPT=-s
		mkdir -p /root/.ssh && chmod 700 /root/.ssh &&
			touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys &&
			while IFS= read -r k; do
				grep -qxF "$k" /root/.ssh/authorized_keys || echo "$k" >>/root/.ssh/authorized_keys
			done <$AKR
		echo "rcS: ssh: key logins only"
	fi
	if [ -x /usr/sbin/sshd ] && /usr/sbin/sshd -f /etc/ssh/sshd_config $(/etc/init.d/sshkeys); then
		echo "rcS: ssh on port 22"
		echo "rcS: ssh server: OpenSSH (Dropbear on 2222)"
		if [ -x /usr/sbin/dropbear ]; then
			dropbear $DB_OPT $(/etc/init.d/hostkey) -p 2222
		fi
	elif [ -x /usr/sbin/dropbear ]; then
		dropbear $(/etc/init.d/hostkey) -p 22 && echo "rcS: ssh on port 22" &&
			echo "rcS: ssh server: Dropbear"
	fi
	httpd -h /www -p 80 && echo "rcS: httpd on port 80"
fi

# Swap: /linux/swap.img on the card (install-swap), when booted from it.
if [ -f /mnt/linux/swap.img ]; then
	if swapon /mnt/linux/swap.img 2>/tmp/swapon.log; then
		echo "rcS: swap on /linux/swap.img"
	else
		echo "rcS: WARNING: swapon /linux/swap.img failed (see /tmp/swapon.log)"
	fi
fi

# The toolchain (CLANG_ON_BOARD_PLAN.md): /linux/toolchain.img on the card
# (install-toolchain), read-only at /opt/llvm.  An image staged while the
# old one was mounted (toolchain.img.next) replaces it first.
if [ -f /mnt/linux/toolchain.img.next ]; then
	rm -f /mnt/linux/toolchain.img && mv /mnt/linux/toolchain.img.next /mnt/linux/toolchain.img &&
		sync && echo "rcS: toolchain: installed the staged toolchain.img.next"
fi
if [ -f /mnt/linux/toolchain.img ]; then
	mkdir -p /opt/llvm
	if mount -t ext4 -o ro,loop /mnt/linux/toolchain.img /opt/llvm 2>/tmp/toolchain.log; then
		echo "rcS: toolchain at /opt/llvm"
	else
		echo "rcS: WARNING: mounting /linux/toolchain.img failed (see /tmp/toolchain.log)"
	fi
fi

if [ -r /data/etc/rc.local ]; then
	echo "rcS: running /data/etc/rc.local"
	sh /data/etc/rc.local </dev/null &
fi
