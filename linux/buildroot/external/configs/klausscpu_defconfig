# KlaussCPU: packages for the system image (linux/buildroot/build.sh).
# No kernel, bootloader, init or busybox: linux/build.sh and our own
# initramfs/rcS do those; build-rootfs.sh merges output/images/rootfs.tar
# into the system image (ROOTFS_BUILDROOT=1).
BR2_klausscpu=y
BR2_DL_DIR="$(KLAUSSCPU_WS)/br-dl"
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(KLAUSSCPU_WS)/br-toolchain"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="klausscpu-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_GCC_14=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_19=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
# BR2_TOOLCHAIN_EXTERNAL_CXX is not set
BR2_STATIC_LIBS=y
BR2_SSP_NONE=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_PACKAGE_BUSYBOX is not set
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_TAR_GZIP is not set
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TMUX=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KLAUSSCPU_PATH)/patches"
BR2_PACKAGE_STRACE=y
# Development and test tools (2026-11-11).
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BC=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_DOS2UNIX=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_DEBUGFS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_DHRYSTONE=y
BR2_PACKAGE_WHETSTONE=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_OPENSSL=y
# OpenSSL's 64-bit C P-256 (needs __int128, little-endian): an OpenSSH login
# 4.42 -> 3.12 s on the board (LINUX_PLAN "SSH servers").  no-asm: no
# assembly for KlaussCPU.
BR2_PACKAGE_LIBOPENSSL_TARGET_ARCH="linux-generic64 no-asm enable-ec_nistp_64_gcc_128"
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_MC=y
