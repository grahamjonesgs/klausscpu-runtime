diff -ruN a/src/linux/klausscpu/ioctls_inc0.h b/src/linux/klausscpu/ioctls_inc0.h
--- a/src/linux/klausscpu/ioctls_inc0.h	1970-01-01 02:00:00.000000000 +0200
+++ b/src/linux/klausscpu/ioctls_inc0.h	2026-11-10 19:10:08.815307839 +0200
@@ -0,0 +1 @@
+#include "../64/ioctls_inc.h"
diff -ruN a/src/linux/klausscpu/set_error.c b/src/linux/klausscpu/set_error.c
--- a/src/linux/klausscpu/set_error.c	1970-01-01 02:00:00.000000000 +0200
+++ b/src/linux/klausscpu/set_error.c	2026-11-10 19:10:08.815258618 +0200
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+static int
+arch_set_error(struct tcb *tcp)
+{
+	klausscpu_regs.r[12] = -tcp->u_error;
+	return set_regs(tcp->pid);
+}
+
+static int
+arch_set_success(struct tcb *tcp)
+{
+	klausscpu_regs.r[12] = tcp->u_rval;
+	return set_regs(tcp->pid);
+}
diff -ruN a/src/linux/klausscpu/set_scno.c b/src/linux/klausscpu/set_scno.c
--- a/src/linux/klausscpu/set_scno.c	1970-01-01 02:00:00.000000000 +0200
+++ b/src/linux/klausscpu/set_scno.c	2026-11-10 19:10:08.815269598 +0200
@@ -0,0 +1,18 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * The kernel keeps the syscall number outside the general registers, so
+ * it can only be changed with PTRACE_SET_SYSCALL_INFO (Linux >= 6.16),
+ * which set_scno tries first; this fallback can't.
+ */
+static int
+arch_set_scno(struct tcb *tcp, kernel_ulong_t scno)
+{
+	errno = ENOSYS;
+	return -1;
+}
diff -ruN a/src/linux/klausscpu/syscallent.h b/src/linux/klausscpu/syscallent.h
--- a/src/linux/klausscpu/syscallent.h	1970-01-01 02:00:00.000000000 +0200
+++ b/src/linux/klausscpu/syscallent.h	2026-11-10 19:10:08.815281080 +0200
