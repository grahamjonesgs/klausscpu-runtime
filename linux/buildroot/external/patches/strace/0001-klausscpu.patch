diff -ruN a/src/linux/klausscpu/arch_sigreturn.c b/src/linux/klausscpu/arch_sigreturn.c
--- a/src/linux/klausscpu/arch_sigreturn.c	1970-01-01 02:00:00.000000000 +0200
+++ b/src/linux/klausscpu/arch_sigreturn.c	2026-11-10 19:18:37.244756714 +0200
@@ -0,0 +1,25 @@
+/*
+ * Copyright (c) 2026 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * At rt_sigreturn the stack pointer is at the kernel's struct rt_sigframe:
+ * the siginfo (128 bytes), then the ucontext in the asm-generic layout,
+ * whose signal mask comes last (musl's ucontext_t matches it).
+ */
+static void
+arch_sigreturn(struct tcb *tcp)
+{
+	kernel_ulong_t sp;
+	uint32_t mask[NSIG_BYTES / sizeof(uint32_t)];
+
+	if (!get_stack_pointer(tcp, &sp))
+		return;
+	const kernel_ulong_t addr = sp + 128 + offsetof(ucontext_t, uc_sigmask);
+	if (umove_or_printaddr(tcp, addr, &mask))
+		return;
+	tprintsigmask_addr(mask);
+}
