 	;;
 
+  klausscpu*-*-*)
+	TARGET=KLAUSSCPU; TARGETDIR=klausscpu
+	SOURCES="ffi.c sysv.S"
+	;;
+
   kvx-*-*)
 	TARGET=KVX; TARGETDIR=kvx
 	SOURCES="ffi.c sysv.S"
