+#define LIBFFI_ASM
+#include <fficonfig.h>
+#include <ffi.h>
+
+/* struct call_frame (ffi.c) */
+#define CF_R0		0
+#define CF_FN		32
+#define CF_STACK	40
+#define CF_NSTACK	48
+#define CF_RET		56
+
+	.text
+
+/* void ffi_call_SYSV(struct call_frame *cf)
+
+   Copies cf->nstack bytes from cf->stack to the bottom of a new stack
+   area, loads R0-R3 and calls cf->fn, so the callee finds the area at
+   its entry SP + 8; then stores R12 and R11 in cf->ret.  R4 (callee-
+   saved) keeps cf across the call.  */
+	.globl	ffi_call_SYSV
+	.hidden	ffi_call_SYSV
+	.type	ffi_call_SYSV, @function
+	.p2align 2
+ffi_call_SYSV:
+	.cfi_startproc
+	enter	0
+	.cfi_def_cfa r15, 16
+	.cfi_offset r15, -16
+	push	r4
+	.cfi_offset r4, -24
+	copy	r4, r0
+	ldidx64	r8, r4, CF_NSTACK
+	ldidx64	r10, r4, CF_STACK
+	getsp	r9
+	subr	r9, r9, r8		# both multiples of 8: SP stays 8-aligned
+	setsp	r9
+1:	fbri	r8, 0, 0, 2f		# EQ: copied
+	ldidx64	r11, r10, 0
+	stidx64	r11, r9, 0
+	addi	r10, r10, 8
+	addi	r9, r9, 8
+	addi	r8, r8, -8
+	jmp	1b
+2:	ldidx64	r0, r4, CF_R0
+	ldidx64	r1, r4, CF_R0 + 8
+	ldidx64	r2, r4, CF_R0 + 16
+	ldidx64	r3, r4, CF_R0 + 24
+	ldidx64	r13, r4, CF_FN
+	callr	r13
+	stidx64	r12, r4, CF_RET
+	stidx64	r11, r4, CF_RET + 8
+	ldidx64	r4, r15, -8
+	leaveret
+	.cfi_endproc
+	.size	ffi_call_SYSV, . - ffi_call_SYSV
+
+/* ffi_closure_SYSV: jumped to by a closure's trampoline with R14 = the
+   closure and everything else as the caller left it ([SP] the return
+   address, the stack arguments from SP + 8).  Saves R0-R3 and calls
+   ffi_closure_klausscpu_inner(closure, regs, entry SP + 8, ret), then
+   returns ret[0] in R12 and ret[1] in R11.
+
+   Frame: R15 + 8 the return address, R15 the caller's R15,
+   R15 - 16 .. - 1 ret[2], R15 - 48 .. - 17 the saved R0-R3.  */
+	.globl	ffi_closure_SYSV
+	.hidden	ffi_closure_SYSV
+	.type	ffi_closure_SYSV, @function
+	.p2align 2
+ffi_closure_SYSV:
+	.cfi_startproc
+	enter	6
+	.cfi_def_cfa r15, 16
+	.cfi_offset r15, -16
+	stidx64	r0, r15, -48
+	stidx64	r1, r15, -40
+	stidx64	r2, r15, -32
+	stidx64	r3, r15, -24
+	copy	r0, r14
+	addi	r1, r15, -48
+	addi	r2, r15, 16
+	addi	r3, r15, -16
+	callrel	ffi_closure_klausscpu_inner
+	ldidx64	r12, r15, -16
+	ldidx64	r11, r15, -8
+	leaveret
+	.cfi_endproc
+	.size	ffi_closure_SYSV, . - ffi_closure_SYSV
+
+/* The trampoline's code, copied into each closure by ffi_prep_closure_loc,
+   which stores the address of ffi_closure_SYSV at +16 and that of the
+   closure at +24.  Position-independent; never run from here.  */
+	.globl	ffi_klausscpu_trampoline
+	.hidden	ffi_klausscpu_trampoline
+	.type	ffi_klausscpu_trampoline, @object
+	.p2align 3
+ffi_klausscpu_trampoline:
+	leapc	r14, .			# its own address (compressed to leapc.s)
+	ldidx64	r13, r14, 16
+	ldidx64	r14, r14, 24
+	jmpr	r13
+	.globl	ffi_klausscpu_trampoline_end
+	.hidden	ffi_klausscpu_trampoline_end
+ffi_klausscpu_trampoline_end:		# ffi.c checks that the code is 16 bytes
+	.size	ffi_klausscpu_trampoline, . - ffi_klausscpu_trampoline
+
+#if defined __ELF__ && defined __linux__
+	.section .note.GNU-stack,"",%progbits
+#endif
