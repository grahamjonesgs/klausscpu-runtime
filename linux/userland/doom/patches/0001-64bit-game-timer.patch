diff --git a/doomgeneric/i_timer.c b/doomgeneric/i_timer.c
index 0a85c72..291e1e1 100644
--- a/doomgeneric/i_timer.c
+++ b/doomgeneric/i_timer.c
@@ -40,18 +40,33 @@ int I_GetTicks(void)
 	return DG_GetTicksMs();
 }
 
-int  I_GetTime (void)
+// KlaussCPU: 64-bit milliseconds since the first call.  DG_GetTicksMs() is
+// 32-bit (wraps after 49.7 days); extend it across the wrap.  The stock
+// (ticks * TICRATE) in 32 bits overflowed after ~34 h (and d_loop's signed
+// version after ~17 h), freezing the game: time jumped back and Doom waited
+// for it to catch up while redrawing the same frame.
+int64_t I_GetTimeMS64(void)
 {
-    uint32_t ticks;
-
-    ticks = I_GetTicks();
-
-    if (basetime == 0)
-        basetime = ticks;
-
-    ticks -= basetime;
+    static uint32_t last;
+    static uint64_t high;
+    static uint64_t base64;
+    static int started;
+    uint32_t now = DG_GetTicksMs();
+
+    if (now < last)
+        high += (uint64_t)1 << 32;
+    last = now;
+    if (!started)
+    {
+        started = 1;
+        base64 = high | now;
+    }
+    return (int64_t)((high | now) - base64);
+}
 
-    return (ticks * TICRATE) / 1000;
+int  I_GetTime (void)
+{
+    return (int)((I_GetTimeMS64() * TICRATE) / 1000);
 }
 
 
