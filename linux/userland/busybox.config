# Busybox options on top of allnoconfig (linux/userland/busybox.sh).
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_LN=y
CONFIG_PWD=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_SORT=y
CONFIG_SEQ=y
CONFIG_SYNC=y
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_HOSTNAME=y
# Interactive use: line editing, history, completion, job control.
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_HELP=y
CONFIG_ASH_RANDOM_SUPPORT=y
# Coreutils and friends.
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_EGREP=y
CONFIG_FEATURE_TEST_64=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_XARGS=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_UNIQ=y
CONFIG_TEE=y
CONFIG_WHICH=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_PRINTF=y
CONFIG_EXPR=y
CONFIG_YES=y
CONFIG_NPROC=y
CONFIG_CAL=y
CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_STAT=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_CHMOD=y
CONFIG_MKNOD=y
CONFIG_MKFIFO=y
CONFIG_USLEEP=y
CONFIG_TIME=y
CONFIG_WATCH=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_STTY=y
CONFIG_TTY=y
CONFIG_MORE=y
CONFIG_LESS=y
CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_FEATURE_DMESG_PRETTY=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
# vi
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=1024
CONFIG_FEATURE_VI_8BIT=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_REGEX_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_UNDO=y
# The SD card (vfat).
CONFIG_FDISK=y
CONFIG_MKDOSFS=y
CONFIG_MKFS_VFAT=y
