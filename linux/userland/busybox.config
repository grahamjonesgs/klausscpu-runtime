# Busybox options on top of allnoconfig (linux/userland/busybox.sh).
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_LN=y
CONFIG_PWD=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_SORT=y
CONFIG_SEQ=y
CONFIG_SYNC=y
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_HOSTNAME=y
