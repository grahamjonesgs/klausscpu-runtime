# linux/userland/busybox-suid.config: the setuid-root busybox (bbsuid) with
# only su and passwd (busybox.sh builds it beside the main one; allnoconfig
# plus these).  Installed /bin/bbsuid 4755, with /bin/su and /usr/bin/passwd
# linking to it; the main busybox is not setuid.
CONFIG_STATIC=y
CONFIG_FEATURE_SUID=y
CONFIG_SU=y
CONFIG_FEATURE_SU_CHECKS_SHELLS=y
CONFIG_PASSWD=y
CONFIG_FEATURE_PASSWD_WEAK_CHECK=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
CONFIG_LAST_ID=60000
CONFIG_FIRST_SYSTEM_ID=100
CONFIG_LAST_SYSTEM_ID=999
# clang treats loads from a const global as invariant (see busybox.config)
CONFIG_EXTRA_CFLAGS="-DBB_GLOBAL_CONST="
# No shell in the setuid binary (allnoconfig's choice default is ash).
CONFIG_SH_IS_NONE=y
CONFIG_SH_IS_ASH=n
CONFIG_SHELL_ASH=n
CONFIG_ASH=n
