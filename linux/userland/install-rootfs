#!/bin/sh
# install-rootfs [-z] <url>|- [sha256]: put a root file system image on the
# SD card as /linux/rootfs.img, over the network, without touching anything
# else on the card (its single FAT partition and its files stay as they
# are).  With "-" the image comes on stdin, e.g. pushed from a PC whose
# firewall won't let the board connect to it.
#
# -z: the image is gzip-compressed and install-rootfs unpacks it.  The image
# is mostly free space, so it shrinks about 90x, and gunzip verifies the
# CRC-32 and length of everything it unpacks, so a damaged or truncated
# transfer fails and leaves the old image alone.  That is the recommended
# way; the SHA-256 is then optional (it re-reads 96 MiB and hashes it in
# software at about 0.8 MB/s, two minutes on the board):
#   gzip -1c rootfs.img | ssh root@<board> install-rootfs -z -
# The image is written beside the old one and renamed only when it is
# complete (and its SHA-256 matches, when given).  Reboot to use it.
set -e
gz=0
if [ "${1:-}" = -z ]; then
	gz=1
	shift
fi
url=${1:-}
want=${2:-}
[ -n "$url" ] || { echo "usage: install-rootfs [-z] <url>|- [sha256]" >&2; exit 2; }
[ -b /dev/mmcblk0p1 ] || { echo "install-rootfs: no SD card" >&2; exit 1; }
mkdir -p /mnt
grep -q " /mnt " /proc/mounts || mount -t vfat /dev/mmcblk0p1 /mnt
mkdir -p /mnt/linux
new=/mnt/linux/rootfs.img.new
rm -f "$new"
fail() {
	echo "install-rootfs: $1, keeping the old image" >&2
	rm -f "$new"
	exit 1
}
if [ "$url" = - ]; then
	echo "install-rootfs: reading the image from stdin"
	if [ $gz = 1 ]; then
		gunzip -c >"$new" || fail "gunzip failed (bad CRC or truncated input)"
	else
		cat >"$new" || fail "cannot write $new"
	fi
else
	echo "install-rootfs: downloading $url"
	if [ $gz = 1 ]; then
		# The pipeline's status is gunzip's: a failed download ends the
		# stream early, which gunzip reports as truncated input.
		wget -O - "$url" | gunzip -c >"$new" || fail "download or gunzip failed"
	else
		wget -O "$new" "$url" || fail "download failed"
	fi
fi
[ $gz = 1 ] && echo "install-rootfs: gzip CRC-32 and length OK"
if [ -n "$want" ]; then
	got=$(sha256sum /mnt/linux/rootfs.img.new | cut -d' ' -f1)
	if [ "$got" != "$want" ]; then
		fail "SHA-256 mismatch ($got)"
	fi
fi
# The new image's data reaches the card before its name does.
sync
if grep -qE '^(/dev/loop[0-9]* /|overlay /|/dev/loop[0-9]* /rofs) ' /proc/mounts; then
	# Running from the card's image (directly, or under sdinit's overlay):
	# don't replace a file that is in use
	# (on FAT that leaks its clusters).  sdinit swaps it in at the next boot.
	rm -f /mnt/linux/rootfs.img.next
	mv /mnt/linux/rootfs.img.new /mnt/linux/rootfs.img.next
	sync
	echo "install-rootfs: staged as /linux/rootfs.img.next; it replaces rootfs.img at the next boot"
else
	rm -f /mnt/linux/rootfs.img.next	# a stale staged image must not replace this one
	mv /mnt/linux/rootfs.img.new /mnt/linux/rootfs.img
	sync
	echo "install-rootfs: /linux/rootfs.img installed; reboot to use it"
fi
